      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"$(basename $PWD) needs your input\\\" with title \\\"Claude Code\\\" sound name \\\"Ping\\\"\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/vishalsaidaswani/.claude/hooks/gsd-check-update.js\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"/Users/vishalsaidaswani/.claude/hooks/gsd-statusline.js\""
  }
}
